generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("staff")
  status       String    @default("PENDING")
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  // Max devices this staffer may successfully activate (counts sessions
  // that reach ENROLLED). null = unlimited. Admin-set only.
  qrQuota      Int?

  sessions EnrollmentSession[]
  claimCodes ManualClaimCode[]
  gmailAccounts GmailAccount[]
  wifiProfiles WifiProfile[]
  auditLogs AuditLog[]
}

// Singleton-ish key/value store for dashboard-wide toggles (e.g. auto-approve
// registration). Not modeled as a single-row table so more settings can be
// added later without a migration each time.
model AppSetting {
  key   String @id
  value String
}

// Treated as personal data — fully silo'd per staff member, no admin
// oversight override (unlike sessions/claim codes/gmail accounts) per
// explicit instruction; revisit once the admin side of the dashboard gets
// designed further.
model WifiProfile {
  id           String   @id @default(cuid())
  label        String
  ssid         String
  password     String?
  securityType String   @default("WPA")
  ownerStaffId String?
  owner        StaffUser? @relation(fields: [ownerStaffId], references: [id])
  createdAt    DateTime @default(now())

  @@index([ownerStaffId])
}

// Pool of company-owned Gmail accounts handed out one-per-device by the
// helper app after activation (see gmailAccount.service.ts). Kept around
// after use (status flips to ASSIGNED, not deleted) so staff can trace which
// device got which account — matters if a device needs re-checking later.
//
// Silo'd per staff member on purpose (see ownerStaffId): a claim can only
// draw from the pool belonging to whoever created the claiming session/code,
// never borrowed across staff — keeps "who's managing what" from turning
// into a shared free-for-all as more staff use the dashboard.
model GmailAccount {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  status              String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | FAILED
  ownerStaffId        String?
  owner               StaffUser? @relation(fields: [ownerStaffId], references: [id])
  assignedToSessionId String?
  assignedToSession   EnrollmentSession? @relation(fields: [assignedToSessionId], references: [id])
  assignedToClaimCodeId String?
  assignedToClaimCode  ManualClaimCode? @relation(fields: [assignedToClaimCodeId], references: [id])
  assignedAt          DateTime?
  note                String?
  createdAt           DateTime  @default(now())

  @@index([status])
  @@index([ownerStaffId])
}

// Manual counterpart to EnrollmentSession's token, for devices that were NOT
// provisioned via the QR/DPC flow (activated normally by hand) but still run
// the helper app afterward. Staff generate a short code on the dashboard,
// type it once into the helper app — same claim/report API as the QR path,
// just a human-typeable identifier instead of one auto-passed by the DPC.
model ManualClaimCode {
  id        String   @id @default(cuid())
  code      String   @unique
  status    String   @default("PENDING") // PENDING | CLAIMED | EXPIRED | REVOKED
  note      String?
  createdByStaffId String?
  createdBy         StaffUser? @relation(fields: [createdByStaffId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
  claimedAt DateTime?

  gmailAccounts GmailAccount[]

  @@index([status])
  @@index([expiresAt])
}

// Server-managed list of apps the helper app installs after Google sign-in —
// editable from the dashboard so changing the target app set never requires
// rebuilding/redeploying the helper APK.
model TargetApp {
  id          String   @id @default(cuid())
  packageName String   @unique
  label       String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// SQLite has no native enum support in Prisma; status/type are validated
// application-side against the string unions in src/types.ts.
model EnrollmentSession {
  id              String        @id @default(cuid())
  token           String        @unique
  status          String        @default("PENDING")

  wifiSsid         String?
  wifiPassword     String?
  wifiSecurityType String?
  locale           String        @default("vi_VN")
  timezone         String?
  note             String?

  createdByStaffId String?
  createdBy         StaffUser? @relation(fields: [createdByStaffId], references: [id])

  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  enrolledAt  DateTime?
  downloadedAt DateTime?

  deviceModel     String?
  androidRelease  String?
  apkVersion      String?
  batteryLevel    Int?
  lastSeenAt      DateTime?

  events EnrollmentEvent[]
  gmailAccounts GmailAccount[]

  @@index([status])
  @@index([expiresAt])
}

model EnrollmentEvent {
  id          String   @id @default(cuid())
  sessionId   String
  session     EnrollmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String
  payloadJson String?
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

// Admin-only audit trail — who did what, when. Written by the routes that
// change shared/sensitive state (target apps, user approvals, etc.); reading
// a session/claim-code/gmail-account's own history is already covered by
// EnrollmentEvent and each row's own timestamps, so this focuses on actions
// that don't otherwise leave a record staff can see.
model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  staff     StaffUser? @relation(fields: [staffId], references: [id])
  action    String   // e.g. "TARGET_APP_ADDED", "USER_APPROVED", "GMAIL_ACCOUNT_ADDED"
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ReleaseApk {
  id               String   @id @default(cuid())
  version          String   @unique
  filename         String
  sha256Base64Url  String
  isActive         Boolean  @default(false)
  uploadedAt       DateTime @default(now())
}
