generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("staff")
  status       String    @default("PENDING")
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())

  sessions EnrollmentSession[]
  claimCodes ManualClaimCode[]
}

// Singleton-ish key/value store for dashboard-wide toggles (e.g. auto-approve
// registration). Not modeled as a single-row table so more settings can be
// added later without a migration each time.
model AppSetting {
  key   String @id
  value String
}

model WifiProfile {
  id           String   @id @default(cuid())
  label        String
  ssid         String
  password     String?
  securityType String   @default("WPA")
  createdAt    DateTime @default(now())
}

// Pool of company-owned Gmail accounts handed out one-per-device by the
// helper app after activation (see gmailAccount.service.ts). Kept around
// after use (status flips to ASSIGNED, not deleted) so staff can trace which
// device got which account — matters if a device needs re-checking later.
model GmailAccount {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  status              String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | FAILED
  assignedToSessionId String?
  assignedToSession   EnrollmentSession? @relation(fields: [assignedToSessionId], references: [id])
  assignedToClaimCodeId String?
  assignedToClaimCode  ManualClaimCode? @relation(fields: [assignedToClaimCodeId], references: [id])
  assignedAt          DateTime?
  note                String?
  createdAt           DateTime  @default(now())

  @@index([status])
}

// Manual counterpart to EnrollmentSession's token, for devices that were NOT
// provisioned via the QR/DPC flow (activated normally by hand) but still run
// the helper app afterward. Staff generate a short code on the dashboard,
// type it once into the helper app — same claim/report API as the QR path,
// just a human-typeable identifier instead of one auto-passed by the DPC.
model ManualClaimCode {
  id        String   @id @default(cuid())
  code      String   @unique
  status    String   @default("PENDING") // PENDING | CLAIMED | EXPIRED | REVOKED
  note      String?
  createdByStaffId String?
  createdBy         StaffUser? @relation(fields: [createdByStaffId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
  claimedAt DateTime?

  gmailAccounts GmailAccount[]

  @@index([status])
  @@index([expiresAt])
}

// Server-managed list of apps the helper app installs after Google sign-in —
// editable from the dashboard so changing the target app set never requires
// rebuilding/redeploying the helper APK.
model TargetApp {
  id          String   @id @default(cuid())
  packageName String   @unique
  label       String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// SQLite has no native enum support in Prisma; status/type are validated
// application-side against the string unions in src/types.ts.
model EnrollmentSession {
  id              String        @id @default(cuid())
  token           String        @unique
  status          String        @default("PENDING")

  wifiSsid         String?
  wifiPassword     String?
  wifiSecurityType String?
  locale           String        @default("vi_VN")
  timezone         String        @default("Asia/Ho_Chi_Minh")
  note             String?

  createdByStaffId String?
  createdBy         StaffUser? @relation(fields: [createdByStaffId], references: [id])

  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  enrolledAt  DateTime?
  downloadedAt DateTime?

  deviceModel     String?
  androidRelease  String?
  apkVersion      String?
  batteryLevel    Int?
  lastSeenAt      DateTime?

  events EnrollmentEvent[]
  gmailAccounts GmailAccount[]

  @@index([status])
  @@index([expiresAt])
}

model EnrollmentEvent {
  id          String   @id @default(cuid())
  sessionId   String
  session     EnrollmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String
  payloadJson String?
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

model ReleaseApk {
  id               String   @id @default(cuid())
  version          String   @unique
  filename         String
  sha256Base64Url  String
  isActive         Boolean  @default(false)
  uploadedAt       DateTime @default(now())
}
