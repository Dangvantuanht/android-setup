# Copy to .env and fill in. Never commit the real .env.

# Random long string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Public HTTPS URL of this server (used inside the QR payload; devices must reach it)
PUBLIC_BASE_URL=https://provisioning.example.com

# How long a generated QR/session stays valid before auto-expiring
SESSION_TTL_MINUTES=20

# SQLite file used by Prisma
DATABASE_URL=file:./data/db.sqlite

# Where session cookies / sqlite session store live
DATA_DIR=./data

# Fixed, signed release APK for the DPC app (see dpc-app/README.md for how to build + sign it)
DPC_COMPONENT_NAME=com.autosetup.dpc/com.autosetup.dpc.AdminReceiver
DPC_APK_PATH=../releases/autosetup-dpc-1.0.0.apk
DPC_APK_VERSION=1.0.0
# base64url(sha256(signing cert)), no padding — computed once at release time, see dpc-app/README.md
DPC_APK_CHECKSUM=

# Optional: override where the QR's download URL points (e.g. a CDN or public
# raw-file URL) instead of this server's own /download/dpc.apk.
DPC_APK_DOWNLOAD_URL=
